---
const choices = [
  ['product','製品を選びたい'],
  ['research','研究テーマから相談したい'],
  ['poc','PoC・システム構成を相談したい'],
  ['quote','見積・納期を相談したい'],
];
---
<button class="chat-trigger" type="button" aria-controls="aa8-chat" aria-expanded="false">AIロボット相談</button>
<section id="aa8-chat" class="chat-panel" hidden aria-label="AIロボット相談">
  <header><div><strong>AIロボット相談</strong><small>AirAdmin8 Robotics</small></div><button type="button" data-chat-close aria-label="閉じる">×</button></header>
  <div class="chat-body" data-chat-log>
    <div class="message assistant">ご相談内容を選んでください。製品名が決まっていなくても、研究テーマから整理できます。</div>
    <div class="choices">
      {choices.map(([value,label]) => <button type="button" data-chat-choice={value}>{label}</button>)}
    </div>
    <p class="policy">価格・納期・契約条件・法令適合・性能保証はAIが確定回答せず、担当者確認へ切り替えます。</p>
  </div>
  <form class="chat-input" data-chat-form>
    <label class="sr-only" for="aa8-chat-input">質問</label>
    <input id="aa8-chat-input" name="message" maxlength="1000" autocomplete="off" placeholder="質問を入力…" />
    <button type="submit">送信</button>
  </form>
</section>
<script>
  const trigger = document.querySelector('.chat-trigger');
  const panel = document.querySelector('#aa8-chat');
  const close = panel?.querySelector('[data-chat-close]');
  const form = panel?.querySelector('[data-chat-form]');
  const log = panel?.querySelector('[data-chat-log]');
  const input = panel?.querySelector('input[name="message"]');
  const open = () => { if (!panel || !trigger) return; panel.hidden=false; trigger.setAttribute('aria-expanded','true'); input?.focus(); };
  const shut = () => { if (!panel || !trigger) return; panel.hidden=true; trigger.setAttribute('aria-expanded','false'); };
  trigger?.addEventListener('click',()=> panel?.hidden ? open() : shut()); close?.addEventListener('click',shut);
  panel?.querySelectorAll('[data-chat-choice]').forEach((button)=>button.addEventListener('click',()=>{ if(input instanceof HTMLInputElement){ input.value=button.textContent?.trim()||''; input.focus(); }}));
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(input instanceof HTMLInputElement) || !input.value.trim() || !log) return;
    const text=input.value.trim(); input.value='';
    const user=document.createElement('div'); user.className='message user'; user.textContent=text; log.appendChild(user);
    const pending=document.createElement('div'); pending.className='message assistant'; pending.textContent='確認しています…'; log.appendChild(pending);
    try {
      const res=await fetch('/api/chat',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({message:text,page:location.pathname})});
      if(!res.ok) throw new Error('chat unavailable');
      const data=await res.json(); pending.textContent=data.answer || '担当者確認が必要です。お問い合わせへお進みください。';
    } catch { pending.textContent='現在AI相談を準備中です。製品・研究テーマのご相談はお問い合わせから担当者へお送りください。'; }
    log.scrollTop=log.scrollHeight;
  });
</script>
<style>
.chat-trigger{position:fixed;right:24px;bottom:24px;z-index:50;border:0;border-radius:999px;background:var(--brand);color:#fff;font-weight:700;padding:14px 18px;box-shadow:0 8px 30px rgba(23,32,51,.14)}.chat-panel{position:fixed;right:24px;bottom:84px;width:min(440px,calc(100vw - 32px));height:min(720px,calc(100vh - 120px));z-index:49;background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 18px 50px rgba(23,32,51,.16)}.chat-panel>header{height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 20px;border-bottom:1px solid var(--line)}.chat-panel header div{display:flex;flex-direction:column}.chat-panel small{color:var(--muted)}.chat-panel header button{border:0;background:transparent;font-size:24px}.chat-body{height:calc(100% - 148px);padding:20px;background:var(--surface);overflow:auto}.message{max-width:88%;padding:12px 14px;border-radius:12px;margin-bottom:12px;background:#fff;border:1px solid var(--line)}.message.user{margin-left:auto;background:var(--brand);color:#fff;border-color:var(--brand)}.choices{display:grid;gap:8px}.choices button{padding:11px 12px;background:#fff;border:1px solid var(--line);border-radius:999px;text-align:left}.policy{font-size:.75rem;color:var(--muted);margin-top:18px}.chat-input{height:72px;padding:10px 12px;display:flex;gap:8px;border-top:1px solid var(--line)}.chat-input input{flex:1;border:1px solid var(--line);border-radius:8px;padding:0 12px;font:inherit}.chat-input button{border:0;border-radius:8px;background:var(--brand);color:#fff;font-weight:700;padding:0 16px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:600px){.chat-trigger{right:16px;bottom:16px}.chat-panel{inset:0;width:100%;height:100%;max-height:none;border-radius:0}}
</style>
