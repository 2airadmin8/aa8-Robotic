---
import '../styles/global.css';
import ChatWidget from '../components/ChatWidget.astro';
const {
  title = 'AirAdmin8 Robotics',
  description = '大学・研究機関向けAIロボット導入支援。',
  canonical = Astro.url.pathname,
} = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">AirAdmin8 <span>ロボティクス</span></a>
        <nav aria-label="グローバルナビゲーション">
          <a href="/products/">製品</a>
          <a href="/solutions/">ソリューション</a>
          <a href="/implementation/">導入支援</a>
          <a href="/cases/">導入事例</a>
          <a href="/physical-ai/">フィジカルAI</a>
          <a class="button primary" href="/contact/">お問い合わせ</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="wrap footer-inner">
        <strong>株式会社AirAdmin8</strong>
        <p>AIロボット導入支援・フィジカルAI実装</p>
      </div>
    </footer>
    <ChatWidget />
  </body>
</html>
<style>
.site-header{height:72px;border-bottom:1px solid var(--line);background:#fff;position:sticky;top:0;z-index:20}.header-inner{height:100%;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{font-weight:800;font-size:1.1rem}.brand span{font-size:.78rem;font-weight:600;color:var(--muted);margin-left:8px}.site-header nav{display:flex;align-items:center;gap:26px;font-size:.9rem;font-weight:600}footer{padding:72px 0;background:var(--surface);border-top:1px solid var(--line)}@media(max-width:900px){.site-header nav a:not(.primary){display:none}}
</style>
